FOOTBALL_API_KEY=
MINIGAME_SPORTSDB_KEY=123
MINIGAME_SPORTSDB_BASE_URL=https://www.thesportsdb.com/api/v1/json
MINIGAME_ESPN_BASE_URL=https://site.api.espn.com/apis/site/v2/sports/soccer
FOOTBALL_PROVIDER=football-data
FOOTBALL_SEASON=2026
CORS_ORIGIN=http://localhost:3000
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
JWT_SECRET=
JWT_ISSUER=football-verse-core
JWT_AUDIENCE=football-verse-api
INTERNAL_TOKEN=dev-internal-token-change-me-2026
# Postgres (compose maps host port POSTGRES_PORT -> container 5432)
DB_NAME=football_verse
DB_USERNAME=football_verse
DB_PASSWORD=
POSTGRES_PORT=54320
# Second database owned by content-ingestion
INGESTION_DB_NAME=ingestion_db
INGESTION_DB_USER=ingestion_user
INGESTION_DB_PASSWORD=ingestion_pass
# Service ports published by compose
GATEWAY_PORT=8000
WEB_PORT=3000
INGESTION_MODE=rss_metadata_shadow
CRAWL_CRON=*/15 * * * *
REDDIT_ACCESS_TOKEN=
TWITTER_BEARER_TOKEN=
YOUTUBE_DATA_API_KEY=
CORE_IMPORT_TIMEOUT_MS=30000
APP_ENV=development
APP_SCHEDULING_ENABLED=true
# vector | vector-shadow | keyword (see ClusterConfiguration)
APP_CLUSTERING_MODE=vector
# Seeds bootstrap admins on first boot; keep false in production.
APP_SEED_ENABLED=false
APP_GATEWAY_URL=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
APP_MAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_APP_PASSWORD=
# Neutral sender identity; override with your verified production domain.
MAIL_FROM=no-reply@footballverse.local
# Base64-encoded 32 random bytes. Generate with: openssl rand -base64 32
APP_MAIL_ENCRYPTION_KEY=
APP_AUTH_RATE_LIMIT_SECRET=
RUN_CRAWL_ON_STARTUP=false
# Web CSP stays report-only until production origin evidence is clean.
CSP_ENFORCE=false

# Billing is disabled until SePay Sandbox and product/legal gates pass.
BILLING_ENABLED=false
BILLING_SALES_ENABLED=false
BILLING_EXPIRY_POLL_MS=300000
SEPAY_ENV=sandbox
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
SEPAY_IPN_SECRET=
SEPAY_CHECKOUT_URL=https://pay-sandbox.sepay.vn/v1/checkout/init
SEPAY_API_URL=https://pgapi-sandbox.sepay.vn
# Bank Hub + VietQR mode (fill these to show your own QR in the Premium page)
SEPAY_BANKHUB_API_KEY=
SEPAY_QR_BANK_CODE=
SEPAY_QR_ACCOUNT_NUMBER=
SEPAY_QR_ACCOUNT_NAME=
SEPAY_QR_TEMPLATE=compact
# ngrok development tunnel (start with `docker compose --profile dev up`).
# The inspector is bound to 127.0.0.1 by default; keep the real token only in .env.
NGROK_AUTHTOKEN=
NGROK_INSPECTOR_PORT=4040
PREMIUM_1_MONTH_PRICE_VND=49000
PREMIUM_3_MONTH_PRICE_VND=129000
PREMIUM_6_MONTH_PRICE_VND=219000
PREMIUM_12_MONTH_PRICE_VND=349000
BILLING_IPN_RATE_LIMIT_MAX=60
# Gateway uses Redis outside focused tests. Set this to the exact number of
# trusted reverse proxies only when the gateway is deployed behind them.
RATE_LIMIT_STORE=redis
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
# Stricter per-IP bucket for /api/v1/auth/** credential endpoints.
AUTH_RATE_LIMIT_MAX=30
TRUST_PROXY_HOPS=0
# Comma-separated proxy IPs allowed to set X-Forwarded-For (core-api side).
APP_TRUSTED_PROXIES=

# External APIs
TELEGRAM_ENABLED=false
TELEGRAM_INSTANT_BREAKING_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@footballverse_news
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
AI_DAILY_LIMIT=20
AI_OUTBOX_POLL_MS=5000
